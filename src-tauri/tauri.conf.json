  "productName": "Boarding Pass",
  "version": "2.33.0",
  "identifier": "com.ebncr.airline-simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
