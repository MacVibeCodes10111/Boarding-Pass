{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boarding Pass",
  "version": "2.57.0",
  "identifier": "com.ebncr.airline-simulator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Boarding Pass",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://*.cartocdn.com https://basemaps.cartocdn.com https://tiles.maps.eox.at",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.cartocdn.com https://basemaps.cartocdn.com https://tiles.maps.eox.at https://dlgkdknfxhmtkhpegufq.supabase.co",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "SimulationGame",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "copyright": "\u00a9 2026 Mac",
    "shortDescription": "A small airline manager game",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0REI2ODUzMjMyNkFBNjgKUldSb3FpWWpVMmpieENBMndyWm5jemJOK2pBVG5Nb016V2FGQ2huS2lWc0RwTEc3azU2cEV6ZEIK",
      "endpoints": [
        "https://github.com/MacVibeCodes10111/Boarding-Pass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "boardingpass"
        ]
      }
    }
  }
}
